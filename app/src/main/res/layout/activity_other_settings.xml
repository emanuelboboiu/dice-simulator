<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/gesture_section"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">
            <CheckBox
                android:id="@+id/onshake_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/checkbox_onshake"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <CheckBox
                android:id="@+id/onshake_pause_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/checkbox_onshake_pause"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <CheckBox
                android:id="@+id/iswakelock_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/checkbox_iswakelock"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <CheckBox
                android:id="@+id/haptic_feedback_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/checkbox_haptic_feedback"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvSortLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/sorting_method"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">
            <RadioButton
                android:id="@+id/radio_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onRadioButtonClicked"
                android:text="@string/sorting_none"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <RadioButton
                android:id="@+id/radio_ascendant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onRadioButtonClicked"
                android:text="@string/sorting_ascendent"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <RadioButton
                android:id="@+id/radio_descendant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onRadioButtonClicked"
                android:text="@string/sorting_descendent"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
