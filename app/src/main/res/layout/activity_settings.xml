<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/audio_section"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">
            <CheckBox
                android:id="@+id/checkbox_dice_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/check_box_dice_sound"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <CheckBox
                android:id="@+id/checkbox_numbers_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:onClick="onCheckboxClicked"
                android:text="@string/check_box_numbers_sound"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/voice_type_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/voice_type"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/radio_recorded_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:onClick="onVoiceTypeClicked"
                    android:text="@string/recorded_voice"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
                <RadioButton
                    android:id="@+id/radio_system_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:onClick="onVoiceTypeClicked"
                    android:text="@string/system_voice"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
